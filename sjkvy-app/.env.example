# Backend (existing sjkvy-api) base URL for the server-side proxy.
API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Dev sign-in issuer (replace with a real identity provider in production).
DEV_JWT_SECRET=must-match-sjkvy-api-JWT_SECRET
DEV_AUTH=true
# Server-only: privileged service token for document finalize/scan/view (BFF). Never client-exposed.
SERVICE_TOKEN=must-match-sjkvy-api-SERVICE_TOKEN
STORAGE_VIEW_SECRET=random-32+char-secret-for-signing-view-urls
# Trusted scanner worker credential (server-to-server; never exposed to the browser).
SCANNER_TOKEN=random-secret-for-the-av-scanner-callback
# Shared document storage dir (BFF writes, scanner worker reads). Defaults to ./.storage
SJKVY_DOC_STORAGE=
