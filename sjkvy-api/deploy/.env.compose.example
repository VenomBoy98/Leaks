# SJKVY compose environment — PLACEHOLDERS ONLY. Copy to `.env` and fill with real,
# strong secrets. `docker compose` reads `.env` automatically. NEVER commit real values.

# --- Postgres ---
POSTGRES_PASSWORD=CHANGE_ME_superuser_password
# Password for the least-privileged API login role (sjkvy_api_login).
API_DB_PASSWORD=CHANGE_ME_api_db_password

# --- API auth (choose ONE verification method) ---
# a) HS256 shared secret (>= 32 chars). For Supabase, this is the project JWT secret.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
# b) OR an asymmetric provider via JWKS (leave JWT_SECRET empty if using this):
JWT_JWKS_URI=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Service-to-service + storage signing (independent strong secrets) ---
SERVICE_TOKEN=CHANGE_ME_service_token_at_least_24_chars
STORAGE_URL_SIGNING_SECRET=CHANGE_ME_at_least_32_characters_signing_secret
# Public base URL clients use for signed upload/download links (through the proxy).
STORAGE_PUBLIC_BASE_URL=https://api.example.org/storage

# --- HTTP / proxy ---
PROXY_HTTP_PORT=80
CORS_ORIGINS=https://app.example.org
RATE_LIMIT_MAX=100
LOG_LEVEL=info
