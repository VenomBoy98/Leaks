{
  "name": "sjkvy-api",
  "version": "0.1.0",
  "private": true,
  "description": "SJKVY thin orchestration API over the verified PostgreSQL function catalogue",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "openapi": "tsx scripts/export-openapi.ts",
    "worker": "tsx src/worker/index.ts",
    "scan-worker": "tsx src/worker/scanner-index.ts",
    "auth:bootstrap-superadmin": "tsx scripts/auth-admin.ts bootstrap-superadmin",
    "auth:grant-role": "tsx scripts/auth-admin.ts grant-role",
    "auth:revoke-role": "tsx scripts/auth-admin.ts revoke-role"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/under-pressure": "^9.1.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
