# SJKVY API — environment template. PLACEHOLDERS ONLY. Never commit real values.
# In production (NODE_ENV=production) startup ABORTS on missing/weak/placeholder secrets.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ---
# The API connects as a LOGIN role that is a member of anon/authenticated/service_role
# and sets SET LOCAL ROLE per request. Never a superuser.
DATABASE_URL=postgres://sjkvy_api_login:CHANGE_ME@localhost:5432/sjkvy
PG_POOL_MAX=10

# --- JWT verification (choose ONE) ---
# a) HS256 shared secret (>= 32 chars in prod). For Supabase = project JWT secret.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
# b) OR JWKS endpoint for asymmetric providers (Supabase JWKS, Auth0, Cognito):
JWT_JWKS_URI=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=
JWT_CLOCK_TOLERANCE_SEC=5

# --- Service-to-service ([SYS] endpoints) ---
SERVICE_TOKEN=CHANGE_ME_at_least_24_chars

# --- Secure storage (signed URLs) ---
STORAGE_URL_SIGNING_SECRET=CHANGE_ME_at_least_32_characters
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/storage
STORAGE_UPLOAD_TTL_SEC=300
STORAGE_DOWNLOAD_TTL_SEC=300
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
STORAGE_DIR=/data/storage

# --- HTTP hardening ---
CORS_ORIGINS=
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- Storage driver selection (production) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=sjkvy-docs
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...        # prefer IAM role over static keys
# AWS_SECRET_ACCESS_KEY=...
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...  # server-only
# STORAGE_BUCKET=documents

# --- Notification providers (worker; unset → deterministic mock) ---
# NOTIFY_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...
# NOTIFY_EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=...
# EMAIL_FROM=no-reply@sjkvy.example
# WORKER_INTERVAL_MS=5000
